{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FDCANBUS Monitor Protocol v1",
  "type": "object",
  "required": [
    "protocol",
    "messages"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": [
        "name",
        "version",
        "bus",
        "nominal_bitrate",
        "data_bitrate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "bus": {
          "type": "string"
        },
        "nominal_bitrate": {
          "type": "integer",
          "minimum": 1
        },
        "data_bitrate": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "id",
          "dlc",
          "signals"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870911
              },
              {
                "type": "string"
              }
            ]
          },
          "dlc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "cycle_ms": {
            "type": "integer",
            "minimum": 0
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "start_bit",
                "length",
                "endian",
                "signed",
                "factor",
                "offset",
                "min",
                "max",
                "ui"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "start_bit": {
                  "type": "integer",
                  "minimum": 0,
                  "multipleOf": 8
                },
                "length": {
                  "enum": [
                    8,
                    16,
                    32
                  ]
                },
                "endian": {
                  "const": "little"
                },
                "signed": {
                  "type": "boolean"
                },
                "factor": {
                  "type": "number",
                  "not": {
                    "const": 0
                  }
                },
                "offset": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "ui": {
                  "type": "object",
                  "required": [
                    "page",
                    "group",
                    "widget",
                    "order",
                    "precision"
                  ],
                  "properties": {
                    "page": {
                      "type": "string",
                      "minLength": 1
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1
                    },
                    "widget": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "precision": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
